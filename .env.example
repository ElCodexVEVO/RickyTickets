# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase.
# NUNCA pongas aqui la SUPABASE_SERVICE_ROLE_KEY: esa clave solo vive en las Edge Functions.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Desarrollo: Photon público se usa por defecto solo en npm run dev.
# Producción: configura tu instancia/proxy compatible; no publiques claves secretas.
# Vacío desactiva búsqueda externa. La selección manual en mapa permanece disponible.
VITE_PHOTON_URL=

# Mosaicos visibles únicamente, con atribución. Sin descargas masivas ni modo offline.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
